# Copy to .env and fill in. .env is gitignored; never commit real values.
OPENAI_API_KEY=

# Level 1 of the three model-configuration levels (FR-1): the process default.
# Deleting this line changes exactly one behaviour: the model that answers a plain question.
OPENAI_DEFAULT_MODEL=gpt-5-nano

# Shop hours used by the dynamic instructions (FR-4).
SHOP_OPEN_HOUR=10
SHOP_CLOSE_HOUR=20

# Optional: freeze the clock so hour-dependent behaviour can be demonstrated (FR-4).
# SHOP_SIMULATED_HOUR=21

# Optional: turn ceiling for a conversation (FR-8). Default 10.
# TURN_CEILING=10

# Optional: path to the catalogue (default: ./catalogue.json).
# CATALOGUE_PATH=catalogue.json
